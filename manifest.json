{
  "manifest_version": 3,
  "name": "Fake Filler Dev",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "description": "Dados fictícios locais em pt-BR e preenchimento inteligente para desenvolvimento e QA.",
  "permissions": ["activeTab", "storage", "scripting", "contextMenus", "clipboardWrite"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fake Filler Dev",
    "default_icon": "icons/32.png"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "fill-all": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "All Inputs: preencher campos vazios"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
